{
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "bashOutputMaxChars": 30000,
  "spinnerTipsEnabled": false,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(tree:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(pwd)",
      "Bash(ps:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(sed -n:*)",
      "Bash(diff:*)",
      "Bash(uniq:*)",
      "Bash(echo:*)",
      "Bash(cd:*)",
      "Bash(printf:*)",
      "Bash(sort:*)",
      "Bash(tr:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(sleep:*)",
      "Bash(du:*)",
      "Bash(strings:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(readlink:*)",
      "Bash(pgrep:*)",
      "Bash(lsof:*)",
      "Bash(infocmp:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git remote:*)",
      "Bash(git stash list:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git check-ignore:*)",

      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",

      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew outdated:*)",
      "Bash(tmux list-clients:*)",
      "Bash(tmux list-sessions:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux list-keys:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux show:*)",
      "Bash(tmux show-options:*)",
      "Bash(tmux display-message:*)",
      "Bash(smug list:*)",
      "Bash(defaults read:*)",

      "Bash(mise ls:*)",
      "Bash(mise current:*)",
      "Bash(mise env:*)",
      "Bash(ghostty +show-config:*)",
      "Bash(ghostty +list-fonts:*)",
      "Bash(docker context ls:*)",
      "Bash(docker info:*)",
      "Bash(docker version:*)",
      "Bash(docker system df:*)",
      "Bash(go version:*)",
      "Bash(go env:*)",
      "Bash(gopls version:*)",
      "Bash(golangci-lint --version:*)",
      "Bash(launchctl list:*)",

      "Bash(curl -s https://raw.githubusercontent.com/:*)",
      "Bash(curl -sL https://raw.githubusercontent.com/:*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.zshrc.local)",
      "Read(~/.zshenv.local)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(sudo:*)"
    ]
  }
}
